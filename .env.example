GITHUB_ORG=Tiger-Studio-WAB
# Optional. Raises GitHub API rate limits for live hub data.
# GITHUB_TOKEN=
# Optional. Studio news repo name. Local content/news/ is the fallback.
# NEWS_REPO=news
# Optional comma-separated GitHub logins allowed to publish news.
# NEWS_AUTHORS=

# Ideas board (Proj.Help). The Vercel Supabase integration usually sets these.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ALLOWED_EMAIL_DOMAIN=wab.edu
